{
  "_version": "1.49.0",
  "sap.app": {
    "id": "supplier",
    "type": "application",
    "title": "Supplier Portal",
    "description": "Supplier portal to upload and send shipment documents",
    "applicationVersion": {
      "version": "1.0.0"
    }
  },
  "sap.ui": {
     "models": {
      "": {
        "dataSource": "shipmentService",
        "type": "sap.ui.model.odata.v4.ODataModel",
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      }
    },
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.108.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    }
  },
  "dataSources": {
      "shipmentService": {
        "uri": "../../../../srv/shipment-service",
        "type": "OData",
        "settings": {
          "defaultBindingMode": "TwoWay"
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": "",
          "name": "Main",
          "target": "Main"
        }
      ],
      "targets": {
        "Main": {
          "viewName": "Main",
          "viewLevel": 1
        }
      }
    }
}
